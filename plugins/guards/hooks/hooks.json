{
  "description": "agentic-github-flow guards: refuse destructive git commands, ask before destructive deletes, and ask before personal data leaves the machine",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_tool_git_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*__run_in_terminal)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_tool_delete_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|WebFetch|WebSearch|Artifact|ArtifactData|ArtifactComments|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_tool_personal_data.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
