{
  "description": "Claude Code ask and deny rules that the agentic-github-flow installer merges into ~/.claude/settings.json with --guards. Deny beats ask beats allow; never add an allow rule for git push.",
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git update-ref*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(git remote rename*)",
      "Bash(gh repo create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh gist create*)",
      "Bash(gh api * -X*)",
      "Bash(gh api -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api --method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api * --input*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git clean*)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout * .)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout * --force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch * --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git tag -f*)",
      "Bash(git tag * -f*)",
      "Bash(git worktree remove*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git replace*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc --prune*)",
      "Bash(git gc * --prune*)",
      "Bash(git prune*)",
      "Bash(git update-ref -d*)",
      "Bash(git update-ref * -d*)",
      "Bash(git commit -n*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(git config core.*)",
      "Bash(git config credential*)",
      "Bash(git config user.*)",
      "Bash(git config * --unset*)",
      "Bash(git add -A*)",
      "Bash(git add * -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add --force*)",
      "Bash(git add * --force*)",
      "Bash(git commit -a*)",
      "Bash(git commit --all *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh release delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh label delete*)",
      "Bash(gh api * DELETE*)",
      "Bash(gh api -XDELETE*)",
      "Bash(gh auth token*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth status * --show-token*)",
      "Bash(gh ssh-key *)",
      "Bash(gh secret *)",
      "Bash(printenv*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(.git/hooks/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)"
    ]
  },
  "gcloud": {
    "description": "Opt-in (--guards gcloud): ask before the Google Cloud command-line programs, and close the gcloud configuration folder, which holds the user's credentials and the Application Default Credentials file, to reads and edits (in Claude Code a Read deny also closes the folder to the Bash sandbox). Issue #89.",
    "ask": [
      "Bash(gcloud)",
      "Bash(gcloud *)",
      "Bash(gsutil)",
      "Bash(gsutil *)",
      "Bash(bq)",
      "Bash(bq *)",
      "Bash(cloud-sql-proxy)",
      "Bash(cloud-sql-proxy *)",
      "Bash(cloud_sql_proxy)",
      "Bash(cloud_sql_proxy *)"
    ],
    "deny": [
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/AppData/Roaming/gcloud/**)",
      "Edit(~/AppData/Roaming/gcloud/**)"
    ]
  }
}
