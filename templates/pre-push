#!/bin/sh
# agentic-github-flow pre-push hook. Refuses remote ref deletions, non-fast-forward (force)
# updates and moving an existing tag, from any agent or spelling. `--no-verify` skips it, which is
# why the rules and the guards forbid that flag.
# One exception: deleting a refs/heads/* branch that is not main, master or the remote's default
# branch (refs/remotes/<remote>/HEAD, else <remote>/main), whose remote tip is already in that
# default branch as last fetched, or is the head commit of a pull request merged into that
# default branch (`gh pr list -R <the remote's URL> --head <branch> --base <default> --state
# merged`, when gh is installed and the remote has a URL; gh alone would prefer a remote
# `upstream`): a merged task branch, as the cleanup-merged skill deletes it. main and master are
# refused by name even when the default branch is another one.
# The landing branch: when HANDOFF.md on the default branch has a row `landing branch` in its
# `## Landing settings` section (the core plugin's landing.py owns the setting; this hook reads
# the same row, as last fetched), that branch is refused by name too, and "merged" means merged
# into it: in its tip as last fetched, or the head of a pull request merged into it. A value
# that is no branch name refuses every deletion.
# The content checks (#40), for every push that sends anything: the hook lists the objects that
# go out (the commits of each pushed ref not in the remote tips the push replaces, nor in the
# pushed-to remote's tracking refs as last fetched when the push goes to the URL they were
# fetched from, plus annotated tags) and runs, from the installed clone
# ($HOME/.agentic-github-flow, where install.sh and install.ps1 put it):
# - the secret scan: plugins/security/scripts/scan_secrets.py --commits;
# - the personal-data check: plugins/guards/scripts/pre_tool_personal_data.py --commits;
# - only when AGENTIC_GITHUB_FLOW_UNASKED_PUSH is set (not empty, not 0), the protected-path
#   check: plugins/core/scripts/push_paths.py. plugins/core/scripts/push_branch.py, the route
#   that pushes a task branch without the user's yes (#26), sets it for its own `git push`, so
#   CI workflows, hooks, permission settings, the installer and rules/core.md still ask.
# Each script's header owns what it looks for. A finding refuses the push and names the rule,
# the file and the commit, never the value. The checks fail closed: a missing clone or Python, a
# script that cannot run, a pushed blob or tree refuses the push. Offline.
# Limits: the tracking refs stand for what the remote has, so fetch before pushing; after
# `git remote set-url` to a new repository, `git fetch --prune` it first, or the old history
# counts as already there. A branch whose base the pushed-to remote lacks (a fork behind its
# upstream, a first push of old history) is judged whole and may be refused for data that is
# public elsewhere. Git LFS uploads file contents in its own hook: only the pointers are read.
# Patterns are a known list (see each script): unknown token formats, encoded or archived
# content and obfuscated addresses pass. A file that is binary in a commit (a NUL byte in its
# first 8000 bytes) and no UTF-16 text has only its name judged there (#55), so text behind
# such bytes, such as a .glb's JSON part, passes.
# Install per repository (worktrees share it): cp pre-push "$(git rev-parse --git-path hooks)/pre-push"
# and chmod +x it; an existing pre-push hook is chained by hand, never overwritten. On Windows,
# Git for Windows runs it with its own sh.
remote="$1"
push_url="$2"
tips=""
known=""
default=$(git symbolic-ref -q "refs/remotes/$remote/HEAD" 2>/dev/null) ||
  default="refs/remotes/$remote/main"
landing=$(git show "$default:HANDOFF.md" 2>/dev/null | awk '
  /^## / { on = ($0 ~ /^## Landing settings[ \t]*$/); next }
  on && /^[ \t]*[|]/ {
    line = $0; sub(/^[ \t]*[|]/, "", line); split(line, cell, "|")
    key = tolower(cell[1]); gsub(/^[ \t]+|[ \t]+$/, "", key)
    if (key == "landing branch") { v = cell[2]; gsub(/[` \t]/, "", v); print v; exit }
  }')
while read lref lsha rref rsha; do
  case "$lsha" in *[!0]*) ;; *)
    case "$rref" in
      refs/heads/main|refs/heads/master|"refs/heads/${default#"refs/remotes/$remote/"}")
        echo "pre-push: refusing to DELETE the default branch $rref" >&2; exit 1 ;;
      refs/heads/*) ;;
      *) echo "pre-push: refusing to DELETE $rref (ask the user)" >&2; exit 1 ;;
    esac
    landed="$default"
    if [ -n "$landing" ]; then
      case "$landing" in -*) landing="-" ;; esac
      if ! git check-ref-format --branch "$landing" >/dev/null 2>&1; then
        echo "pre-push: refusing to DELETE $rref: \`landing branch\` in HANDOFF.md is no branch name" >&2
        exit 1
      fi
      if [ "$rref" = "refs/heads/$landing" ]; then
        echo "pre-push: refusing to DELETE the landing branch $rref" >&2; exit 1
      fi
      landed="refs/remotes/$remote/$landing"
    fi
    if git merge-base --is-ancestor "$rsha" "$landed" 2>/dev/null; then
      continue
    fi
    branch=${rref#refs/heads/}
    url=$(git remote get-url "$remote" 2>/dev/null)
    if [ -n "$url" ] && command -v gh >/dev/null 2>&1 &&
       gh pr list -R "$url" --head "$branch" --base "${landed#"refs/remotes/$remote/"}" \
         --state merged --json headRefOid --jq '.[].headRefOid' 2>/dev/null | grep -qx "$rsha"; then
      continue
    fi
    echo "pre-push: refusing to DELETE $rref: its tip is not in $landed and is not the head" >&2
    echo "  of a merged pull request (fetch first; unmerged work: ask the user)" >&2
    exit 1 ;;
  esac
  case "$rsha" in *[!0]*)
    case "$rref" in refs/tags/*) echo "pre-push: refusing to MOVE tag $rref" >&2; exit 1 ;; esac
    if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      echo "pre-push: refusing NON-FAST-FORWARD update of $rref (force push). Ask the user." >&2
      exit 1
    fi
    known="$known $rsha" ;;
  esac
  tips="$tips $lsha"
done
[ -n "$tips" ] || exit 0

refuse() {
  echo "pre-push: refusing the push: $1" >&2
  [ -z "$2" ] || printf '%s\n' "$2" | sed 's/^/  /' >&2
  [ -z "$3" ] || echo "  $3" >&2
  exit 1
}
flow="$HOME/.agentic-github-flow"
for script in plugins/security/scripts/scan_secrets.py \
    plugins/guards/scripts/pre_tool_personal_data.py plugins/core/scripts/push_paths.py; do
  [ -f "$flow/$script" ] || refuse "the checks cannot run: $flow/$script is missing" "" \
    "Install or update agentic-github-flow (install.sh --update), or ask the user."
done
python=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 &&
     "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    python="$candidate"; break
  fi
done
if [ -z "$python" ] && command -v py >/dev/null 2>&1; then python="py -3"; fi
[ -n "$python" ] || refuse "the checks cannot run: no Python 3.8+ found" "" "Ask the user."

# only commits and tags pointing at commits: a blob or tree carries content no check reads
tags=""
for tip in $tips; do
  [ "$(git cat-file -t "$tip^{}" 2>/dev/null)" = commit ] ||
    refuse "$tip is not a commit (or a tag of one): its content would go out unchecked" "" \
      "Ask the user."
  [ "$(git cat-file -t "$tip" 2>/dev/null)" = tag ] && tags="$tags
$tip"
done
# what goes out: commits the remote does not have as far as this clone knows. Its tracking refs
# count only when the push goes where they were fetched from (same host and path, whatever the
# scheme or user): a pushurl elsewhere, or a remote given as a URL, trusts none of them.
norm() {
  printf '%s' "$1" | sed -e 's#^[A-Za-z][A-Za-z0-9+.-]*://##' -e 's#^[^@/]*@##' \
    -e 's#^\([^/:]*\):\([^0-9/]\)#\1/\2#' -e 's#/*$##' -e 's#\.git$##' | tr 'A-Z' 'a-z'
}
fetch_url=$(git remote get-url "$remote" 2>/dev/null) || fetch_url=""
case "$remote" in -*) fetch_url="" ;; esac
tracked=""
if [ -n "$fetch_url" ] && [ "$(norm "$fetch_url")" = "$(norm "$push_url")" ]; then
  tracked="--remotes=$remote"
fi
# shellcheck disable=SC2086
objects=$(git rev-list $tips --not $known $tracked --) ||
  refuse "the checks cannot run: git cannot list the outgoing commits" "" "Ask the user."
objects="$objects$tags"
objects=$(printf '%s\n' "$objects" | sed '/^$/d')
[ -n "$objects" ] || exit 0

out=$(printf '%s\n' "$objects" |
      $python -I "$flow/plugins/security/scripts/scan_secrets.py" . --commits - 2>&1)
case $? in
  0) ;;
  1) refuse "the secret scan found secrets in the outgoing commits (rule, file:line, commit):" \
       "$(printf '%s\n' "$out" | grep -v '^scan_secrets:')" \
       "Never push a secret: tell the user the file and the commit; a real one is revoked first." ;;
  *) refuse "the secret scan could not run:" "$out" "Ask the user." ;;
esac
out=$(printf '%s\n' "$objects" |
      $python -I "$flow/plugins/guards/scripts/pre_tool_personal_data.py" --commits "$push_url" 2>&1)
case $? in
  0) ;;
  1) refuse "the outgoing commits carry personal data (what, file:line, commit):" "$out" \
       "Personal data leaves the machine only on the user's explicit confirmation: ask the user." ;;
  *) refuse "the personal-data check could not run:" "$out" "Ask the user." ;;
esac
case "${AGENTIC_GITHUB_FLOW_UNASKED_PUSH:-}" in
  ""|0) ;;
  *)
    out=$(printf '%s\n' "$objects" | $python -I "$flow/plugins/core/scripts/push_paths.py" . 2>&1)
    case $? in
      0) ;;
      1) refuse "a push without the user's yes changes a protected path (path, commit):" "$out" \
           "CI workflows, hooks, permission settings, the installer and the rules: ask the user." ;;
      *) refuse "the protected-path check could not run:" "$out" "Ask the user." ;;
    esac ;;
esac
exit 0
